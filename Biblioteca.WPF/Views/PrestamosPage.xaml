<Page x:Class="Biblioteca.WPF.Views.PrestamosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Préstamos"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Préstamos y devoluciones" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Registra préstamos de uno o varios libros y las devoluciones con su multa por retraso."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- ====== Pestaña: registrar préstamo ====== -->
            <TabItem Header="Registrar préstamo">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Socio + libros disponibles -->
                    <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="1. Selecciona el socio" Style="{StaticResource SectionTitle}" />
                            <ComboBox x:Name="cboSocio" Margin="0,10,0,0" DisplayMemberPath="Nombre" />

                            <TextBlock Text="2. Agrega libros" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                            <TextBlock Text="Solo se muestran libros activos con ejemplares disponibles."
                                       Style="{StaticResource HintText}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboLibro" Grid.Column="0" DisplayMemberPath="Titulo" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10"
                                           Icon="{ui:SymbolIcon Add24}" ToolTip="Agregar a la lista"
                                           Click="btnAgregarLibro_Click" />
                            </Grid>

                            <ui:Button Margin="0,24,0,0" Appearance="Primary" Content="Registrar préstamo"
                                       Icon="{ui:SymbolIcon Save24}" Click="btnRegistrarPrestamo_Click" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Libros del préstamo -->
                    <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Libros del préstamo" Style="{StaticResource SectionTitle}" />
                                <ui:Button HorizontalAlignment="Right" Padding="10" Content="Quitar"
                                           Icon="{ui:SymbolIcon Delete24}" ToolTip="Quitar el libro seleccionado"
                                           Click="btnQuitarLibro_Click" />
                            </Grid>

                            <DataGrid x:Name="dgSeleccionados" Grid.Row="1" Style="{StaticResource ModernGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="3*"
                                                        ElementStyle="{StaticResource TextCell}" />
                                    <DataGridTextColumn Header="Autor" Binding="{Binding NombreAutor}" Width="2*"
                                                        ElementStyle="{StaticResource TextCell}" />
                                    <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}" Width="90"
                                                        ElementStyle="{StaticResource NumberCell}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel x:Name="emptySeleccionados" Style="{StaticResource EmptyState}">
                                <ui:SymbolIcon Symbol="BookAdd24" FontSize="42" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Agrega uno o varios libros al préstamo" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                            </StackPanel>

                            <ui:ProgressRing x:Name="loadingPrestamo" Grid.RowSpan="2" Width="44" Height="44"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="Collapsed" IsIndeterminate="True" />
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ====== Pestaña: registrar devolución ====== -->
            <TabItem Header="Registrar devolución">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="1. Selecciona el socio" Style="{StaticResource SectionTitle}" />
<ComboBox x:Name="cboSocioDevolucion" Margin="0,10,0,0" DisplayMemberPath="Nombre"
                                             SelectionChanged="cboSocioDevolucion_SelectionChanged" />

                            <TextBlock Text="Multa por retraso" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                            <TextBlock Text="Se calcula S/ 1.50 por cada día de retraso en la capa de Negocio."
                                       Style="{StaticResource HintText}" />
                            <TextBlock x:Name="txtMulta" Text="S/ 0.00" Style="{StaticResource StatValue}" Margin="0,8,0,0" />

                            <ui:Button x:Name="btnDevolver" Margin="0,24,0,0" Appearance="Primary"
                                       Content="Registrar devolución" Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Click="btnDevolver_Click" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Libros pendientes de devolución"
                                       Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                            <DataGrid x:Name="dgPendientes" Grid.Row="1" Style="{StaticResource ModernGrid}"
                                      SelectionChanged="dgPendientes_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Libro" Binding="{Binding TituloLibro}" Width="3*"
                                                        ElementStyle="{StaticResource TextCell}" />
                                    <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"
                                                        Width="110" ElementStyle="{StaticResource TextCell}" />
                                    <DataGridTextColumn Header="Días retraso" Binding="{Binding DiasRetraso}" Width="100"
                                                        ElementStyle="{StaticResource NumberCell}" />
                                    <DataGridTextColumn Header="Multa" Binding="{Binding Multa, StringFormat='S/ '0.00}" Width="90"
                                                        ElementStyle="{StaticResource NumberCell}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel x:Name="emptyPendientes" Style="{StaticResource EmptyState}">
                                <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="42" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="El socio no tiene libros pendientes" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                            </StackPanel>

                            <ui:ProgressRing x:Name="loadingDevolucion" Grid.RowSpan="2" Width="44" Height="44"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="Collapsed" IsIndeterminate="True" />
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
