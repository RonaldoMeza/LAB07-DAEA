<Page x:Class="Biblioteca.WPF.Views.SociosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Socios"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Socios" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Registra, busca y gestiona los socios. La eliminación es lógica (Activo = 0)."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Lista de socios -->
            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:DropDownButton x:Name="btnCriterio" Grid.Column="0" Content="Por nombre" Margin="0,0,8,0">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="Por nombre" Click="criterioNombre_Click" />
                                    <MenuItem Header="Por DNI" Click="criterioDni_Click" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ui:TextBox x:Name="txtSearch" Grid.Column="1" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Buscar por nombre…"
                                    ClearButtonEnabled="True" TextChanged="txtSearch_TextChanged" />
                        <ui:Button x:Name="btnRefresh" Grid.Column="2" Margin="8,0,0,0" Padding="10"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Actualizar"
                                   Click="btnRefresh_Click" />
                    </Grid>

                    <DataGrid x:Name="dgSocios" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgSocios_SelectionChanged"
                              MouseDoubleClick="dgSocios_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="110"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"
                                                ElementStyle="{StaticResource TextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" Style="{StaticResource EmptyState}">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="42" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No se encontraron socios" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                    </StackPanel>

                    <ui:ProgressRing x:Name="loading" Grid.RowSpan="2" Width="44" Height="44"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="Collapsed" IsIndeterminate="True" />
                </Grid>
            </ui:Card>

            <!-- Formulario de edición -->
            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Datos del socio" Style="{StaticResource SectionTitle}" />

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="DNI" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="txtDni" PlaceholderText="Ej. 45678901" />

                        <TextBlock Text="Nombre completo" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="txtNombre" PlaceholderText="Ej. Ana Torres Ríos" />

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="txtEmail" PlaceholderText="Ej. ana.torres@mail.com" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <ui:Button x:Name="btnGuardar" Appearance="Primary" Content="Registrar"
                                   Icon="{ui:SymbolIcon Save24}" Click="btnGuardar_Click" />
                        <ui:Button x:Name="btnNuevo" Margin="0,8,0,0" Content="Nuevo"
                                   Icon="{ui:SymbolIcon Add24}" Click="btnNuevo_Click" />
                        <ui:Button x:Name="btnEliminar" Margin="0,8,0,0" Appearance="Danger" Content="Dar de baja"
                                   Icon="{ui:SymbolIcon Delete24}" Click="btnEliminar_Click" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
