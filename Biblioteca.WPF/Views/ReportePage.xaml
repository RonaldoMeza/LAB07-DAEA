<Page x:Class="Biblioteca.WPF.Views.ReportePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Reporte"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reporte de préstamos" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Préstamos registrados en un intervalo de fechas (INNER JOIN entre Prestamos, DetallePrestamo, Libros y Socios)."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ui:Card Grid.Row="1" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filtro por intervalo de fechas -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Desde" VerticalAlignment="Center"
                               Style="{StaticResource HintText}" Margin="0,0,8,0" />
                    <DatePicker x:Name="dpDesde" Grid.Column="1" />

                    <TextBlock Grid.Column="2" Text="Hasta" VerticalAlignment="Center"
                               Style="{StaticResource HintText}" Margin="16,0,8,0" />
                    <DatePicker x:Name="dpHasta" Grid.Column="3" />

                    <ui:Button Grid.Column="4" Margin="16,0,0,0" Appearance="Primary" Content="Buscar"
                               Icon="{ui:SymbolIcon Search24}" Click="btnBuscar_Click" />
                </Grid>

                <DataGrid x:Name="dgReporte" Grid.Row="1" Style="{StaticResource ModernGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding PrestamoId}" Width="60"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="2*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="3*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Fecha préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}"
                                            Width="110" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"
                                            Width="110" ElementStyle="{StaticResource TextCell}" />
                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}">
                                        <TextBlock Style="{StaticResource StatusPillText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="emptyState" Style="{StaticResource EmptyState}">
                    <ui:SymbolIcon Symbol="DocumentTable24" FontSize="42" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No hay préstamos en el intervalo seleccionado" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                </StackPanel>

                <ui:ProgressRing x:Name="loading" Grid.RowSpan="2" Width="44" Height="44"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed" IsIndeterminate="True" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
